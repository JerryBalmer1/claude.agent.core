{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude.agent.core/response/1",
  "title": "scripts/Invoke-Core.ps1 response",
  "description": "Exactly one JSON object on stdout, and nothing else. ok true means exit 0 and a result; ok false means exit 1 and an error whose code is the module's ErrorId, or one of bad-request and sig-not-implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [ "ok", "op" ],
  "properties": {
    "ok": { "type": "boolean" },
    "op": { "type": [ "string", "null" ] },
    "result": { "type": "object" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "code", "message" ],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": [ "ok", "op" ], "properties": { "ok": { "const": true }, "op": { "const": "policy.evaluate" } } },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "additionalProperties": false,
            "required": [ "decision", "matched", "haltCount", "ruleCount" ],
            "properties": {
              "decision": { "enum": [ "allow", "deny" ] },
              "matched": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "haltCount": { "type": "integer", "minimum": 0 },
              "ruleCount": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  ],
  "if": { "properties": { "ok": { "const": true } } },
  "then": { "required": [ "result" ], "not": { "required": [ "error" ] } },
  "else": { "required": [ "error" ], "not": { "required": [ "result" ] } }
}
