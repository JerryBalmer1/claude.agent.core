{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude.agent.core/request/1",
  "title": "scripts/Invoke-Core.ps1 request",
  "description": "One JSON object on stdin. `op` selects the operation and the rest are its arguments. The object is deliberately OPEN (no additionalProperties: false) so a future `sig` field can be added without breaking a schema. It is not implemented: Invoke-Core.ps1 refuses a request that carries `sig` (error code sig-not-implemented) rather than accept a signature it does not verify.",
  "type": "object",
  "required": [ "op" ],
  "properties": {
    "op": { "enum": [ "ledger.append", "ledger.verify", "policy.evaluate", "plan.validate" ] }
  },
  "allOf": [
    {
      "if": { "properties": { "op": { "const": "ledger.append" } } },
      "then": {
        "required": [ "path", "attempt", "validator", "mode", "model", "sha256" ],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "attempt": { "type": "integer", "minimum": 1 },
          "validator": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "ledger.verify" } } },
      "then": { "required": [ "path" ], "properties": { "path": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": { "properties": { "op": { "const": "policy.evaluate" } } },
      "then": { "required": [ "path" ], "properties": { "path": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": { "properties": { "op": { "const": "plan.validate" } } },
      "then": { "required": [ "plan" ], "properties": { "plan": { "type": "object" } } }
    }
  ]
}
